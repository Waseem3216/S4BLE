{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "/infrastructure-posture",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/infrastructure-posture",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/infrastructure-posture",
      "destination": "/index.html"
    },
    {
      "source": "/terraform-pr-reviewer",
      "destination": "/index.html"
    },
    {
      "source": "/import-infrastructure",
      "destination": "/index.html"
    }
  ]
}
