{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "/infrastructure-posture",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/infrastructure-posture",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/infrastructure-posture",
      "destination": "/index.html"
    },
    {
      "source": "/terraform-pr-reviewer",
      "destination": "/index.html"
    },
    {
      "source": "/import-infrastructure",
      "destination": "/index.html"
    },
    {
      "source": "/resource-explorer",
      "destination": "/index.html"
    },
    {
      "source": "/cloud-guide",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; form-action 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; script-src-attr 'none'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
